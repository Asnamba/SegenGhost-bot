# Base de données (SQLite par défaut, PostgreSQL recommandé en production)
DATABASE_URL=sqlite:///./segenghost.db
# Exemple PostgreSQL : postgresql://user:password@localhost:5432/segenghost
# (le driver psycopg2-binary est déjà inclus dans requirements.txt)

# --- Discord ---
# Créer un webhook dans : Paramètres du salon > Intégrations > Webhooks
DISCORD_WEBHOOK_URGENT=
DISCORD_WEBHOOK_DIGEST=

# --- Telegram ---
# Créer un bot via @BotFather pour obtenir le token
TELEGRAM_BOT_TOKEN=
# Chat ID du canal public SegenGhost Security (les abonnés)
TELEGRAM_CHANNEL_CHAT_ID=
# Chat ID privé de l'administrateur (pour notification push + relai WhatsApp)
TELEGRAM_ADMIN_CHAT_ID=

# --- IA (rédaction contrôlée) ---
# Fournisseur actif : gemini ou anthropic (Gemini par défaut)
AI_PROVIDER=gemini
# Clé gratuite via Google AI Studio, généralement sans carte bancaire pour le tier gratuit
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Anthropic est une alternative payante : nécessaire uniquement si AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_MAX_RETRIES=2
AI_TIMEOUT_SECONDS=30

# --- Seuils et fréquences ---
CVSS_URGENT_THRESHOLD=8.5
COLLECT_INTERVAL_MINUTES=15

# --- Réseau / résilience ---
HTTP_TIMEOUT_SECONDS=15
RSS_FETCH_MAX_RETRIES=2

# --- Logging ---
# Niveaux possibles : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Sécurité ---
# Obligatoire pour les déclenchements manuels en production
ADMIN_API_TOKEN=
# Protège le dashboard et l'API lorsqu'ils sont renseignés
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Un seul processus doit exécuter le scheduler en production multi-worker
SCHEDULER_ENABLED=true
